<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Tab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_tab_off</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#FF1E1B4B</item>
        <item name="android:navigationBarColor">#FF0B1020</item>
        <item name="android:colorAccent">#FFF97316</item>
        <item name="android:windowBackground">#FF0B1020</item>
    </style>
</resources>
