<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Kopf -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="18dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_round_btn"
                    android:contentDescription="Zurück"
                    android:src="@drawable/ic_back"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/brand"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_logo" />

                <TextView
                    android:id="@+id/pageTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:maxLines="1"
                    android:text="Hitradar"
                    android:textColor="@color/c_ffffffff"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/liveChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:textColor="@color/c_ff2ee6a8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/searchBox"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_search"
                android:visibility="gone">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="16dp"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/search"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="Lied, Künstler oder Sender"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingStart="48dp"
                    android:paddingEnd="48dp"
                    android:singleLine="true"
                    android:textColor="@color/c_ffffffff"
                    android:textColorHint="@color/c_80ffffff"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/clear"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginEnd="4dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Löschen"
                    android:src="@drawable/ic_close"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="12dp" />

        <!-- Statusbalken: Wächter / Hit-Mix -->
        <LinearLayout
            android:id="@+id/strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_action_dark"
            android:foreground="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/stripIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:tint="@color/c_ff2ee6a8" />

            <TextView
                android:id="@+id/stripText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/c_ffffffff"
                android:textSize="13sp" />

            <ImageButton
                android:id="@+id/stripClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Beenden"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <!-- Mini-Player -->
        <LinearLayout
            android:id="@+id/mini"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_player"
            android:elevation="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/miniProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginStart="18dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="18dp"
                android:progressBackgroundTint="@color/c_22ffffff"
                android:progressTint="@color/c_ff2ee6a8" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp">

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp">

                    <TextView
                        android:id="@+id/miniInitials"
                        style="@style/Initials"
                        android:textSize="18sp" />

                    <ImageView
                        android:id="@+id/miniArt"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <de.gamingdoodz.radiofinder.EqualizerView
                            android:id="@+id/miniEq"
                            android:layout_width="16dp"
                            android:layout_height="14dp"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:id="@+id/miniTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/c_ffffffff"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/miniSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/c_b3ffffff"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/miniPlay"
                    android:tint="@color/c_ff08131c"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_play"
                    android:contentDescription="Abspielen"
                    android:src="@drawable/ic_play" />

                <ImageButton
                    android:id="@+id/miniNext"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="2dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Weiter"
                    android:src="@drawable/ic_next" />
            </LinearLayout>
        </LinearLayout>

        <!-- Untere Leiste -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/bg_nav"
            android:orientation="horizontal">

            <LinearLayout android:id="@+id/navHome" style="@style/NavItem">
                <ImageView android:id="@+id/navHomeIcon" style="@style/NavIcon" android:src="@drawable/ic_home" />
                <TextView android:id="@+id/navHomeLabel" style="@style/NavLabel" android:text="Start" />
            </LinearLayout>

            <LinearLayout android:id="@+id/navFind" style="@style/NavItem">
                <ImageView android:id="@+id/navFindIcon" style="@style/NavIcon" android:src="@drawable/ic_search" />
                <TextView android:id="@+id/navFindLabel" style="@style/NavLabel" android:text="Musik" />
            </LinearLayout>

            <LinearLayout android:id="@+id/navStories" style="@style/NavItem">
                <ImageView android:id="@+id/navStoriesIcon" style="@style/NavIcon" android:src="@drawable/ic_book" />
                <TextView android:id="@+id/navStoriesLabel" style="@style/NavLabel" android:text="Hörspiele" />
            </LinearLayout>

            <LinearLayout android:id="@+id/navLib" style="@style/NavItem">
                <ImageView android:id="@+id/navLibIcon" style="@style/NavIcon" android:src="@drawable/ic_library" />
                <TextView android:id="@+id/navLibLabel" style="@style/NavLabel" android:text="Bibliothek" />
            </LinearLayout>

            <LinearLayout android:id="@+id/navSettings" style="@style/NavItem">
                <ImageView android:id="@+id/navSettingsIcon" style="@style/NavIcon" android:src="@drawable/ic_settings" />
                <TextView android:id="@+id/navSettingsLabel" style="@style/NavLabel" android:text="Mehr" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Großer Player -->
    <FrameLayout
        android:id="@+id/full"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/c_ff0a0b18"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/fullBg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.55"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_full_overlay" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/fullClose"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_round_btn"
                    android:contentDescription="Schließen"
                    android:src="@drawable/ic_chevron_down" />

                <TextView
                    android:id="@+id/fullSource"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:letterSpacing="0.1"
                    android:textColor="@color/c_b3ffffff"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/fullSleep"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_search"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="☾ Timer"
                    android:textColor="@color/c_ffffffff"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/fullStoryBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/fullAgain"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_search"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="↻ Nochmal von vorn hören"
                    android:textColor="@color/c_ff2ee6a8"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/fullBack30"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_search"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="↺ 30 s"
                    android:textColor="@color/c_ffffffff"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/fullSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_search"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="1,0×"
                    android:textColor="@color/c_ff2ee6a8"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/fullFwd30"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_search"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="30 s ↻"
                    android:textColor="@color/c_ffffffff"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/fullArtBox"
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:elevation="16dp">

                <TextView
                    android:id="@+id/fullInitials"
                    style="@style/Initials"
                    android:textSize="84sp" />

                <ImageView
                    android:id="@+id/fullArt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>

            <TextView
                android:id="@+id/fullBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_badge"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:text="● LIVE IM RADIO"
                android:textColor="@color/c_ffffffff"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/fullTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:maxLines="3"
                android:textColor="@color/c_ffffffff"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/fullSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/c_b3ffffff"
                android:textSize="16sp" />

            <de.gamingdoodz.radiofinder.EqualizerView
                android:id="@+id/fullEq"
                android:layout_width="200dp"
                android:layout_height="44dp"
                android:layout_marginTop="18dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <SeekBar
                android:id="@+id/fullSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressBackgroundTint="@color/c_33ffffff"
                android:progressTint="@color/c_ff2ee6a8"
                android:thumbTint="@color/c_ffffffff" />

            <LinearLayout
                android:id="@+id/fullTimes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/fullPos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/c_b3ffffff"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/fullDur"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/c_b3ffffff"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton android:id="@+id/fullFav" style="@style/FullBtn" android:contentDescription="Favorit" android:src="@drawable/ic_heart_outline" />
                <ImageButton android:id="@+id/fullPrev" style="@style/FullBtn" android:contentDescription="Zurück" android:src="@drawable/ic_prev" />

                <ImageButton
                    android:id="@+id/fullPlay"
                    android:tint="@color/c_ff08131c"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_play"
                    android:contentDescription="Abspielen"
                    android:elevation="8dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_play" />

                <ImageButton android:id="@+id/fullNext" style="@style/FullBtn" android:contentDescription="Weiter" android:src="@drawable/ic_next" />
                <ImageButton android:id="@+id/fullStop" style="@style/FullBtn" android:contentDescription="Stopp" android:src="@drawable/ic_stop" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
